# API de SEGISPRO. En local el backend corre en el 3001 con `npm run start:dev`
# desde `segispro-backend-v2`.
VITE_API_URL=http://localhost:3001/api

# Endpoint público de agregados que congela `scripts/sync-metricas.mjs`.
# En GitHub Actions llega como el secreto `API_STATS_URL`.
API_STATS_URL=http://localhost:3001/api/public/stats

# URL del campus institucional al que redirigen las rutas de capacitaciones.
VITE_APP_SEGISPRO=https://app.segispro.com

# Clave pública de reCAPTCHA v3 para el formulario de hojas de vida.
# Sin ella el script no se carga y el backend, que tampoco exige la suya cuando
# le falta, deja pasar el envío: así el formulario funciona en local sin claves.
VITE_RECAPTCHA_SITE_KEY=
